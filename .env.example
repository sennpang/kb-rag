# ─────────────────────────────────────────────────────────────
# 复制本文件为 .env.local 并填入真实值
# 所有密钥只在服务端读取，切勿加 NEXT_PUBLIC_ 前缀、切勿提交 Git
# ─────────────────────────────────────────────────────────────

# PostgreSQL（docker-compose.yml 已内置 pgvector 扩展）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kbrag

# Auth.js v5：会话 JWT 签名密钥。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 本地与 Vercel 使用各自独立的值；生产环境缺失会启动报错
AUTH_SECRET=replace-with-random-32-bytes-base64

# 对话模型：DeepSeek（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# Embedding：硅基流动 SiliconFlow（OpenAI 兼容协议）
# bge-m3 输出 1024 维；如改用 OpenAI text-embedding-3-small，请填 1536
# 注意：EMBEDDING_DIMENSIONS 必须在执行 pnpm db:init 之前确定；改维度需重建 chunks 表
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# 上传限制：本地 20；部署 Vercel 时在平台环境变量改为 4
MAX_FILE_SIZE_MB=20

# 邮箱验证码（QQ 邮箱 SMTP）
# 获取授权码：QQ 邮箱 → 设置 → 账号 → 「POP3/IMAP/SMTP/Exchange/CardDAV/CalDAVP 服务」
#   → 开启 IMAP/SMTP 服务 → 按提示用手机发短信生成「授权码」（16 位，不是 QQ 密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=your-smtp-authorization-code
